[Unit]
Description=Homelab Power Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/HomelabPowerMangeger
ExecStart=/home/pi/HomelabPowerMangeger/.venv/bin/python /home/pi/HomelabPowerMangeger/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
